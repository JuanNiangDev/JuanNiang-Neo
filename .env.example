# JuanNiang-Neo 环境变量样例
# 用法: cp .env.example .env 并按需修改; docker compose 会自动读取同目录 .env。
# 同样的变量也能直接 export 给裸跑的二进程或 systemd unit。

# ---------- 前端静态资源目录 ----------
# 生产环境默认 web/dist; 容器内为 /app/web/dist。
# 开发模式留空即可 (前端走 Vite :3000, 代理 /api 到后端):
WEB_DIR=web/dist

# ---------- Web 管理面板 ----------
API_ADDR=:8090
# JWT 签名密钥, 生产环境务必修改:
JWT_SECRET=change-me-in-production

# ---------- OneBot11 反向 WebSocket 适配器 ----------
OB_PORT=8081
# OneBot11 客户端连接本服务端所需的 access_token (留空表示不校验):
OB_TOKEN=
# 管理员 QQ 号 (逗号分隔), 用于接搜 OneBot11 上行指令:
OB_ADMINS=

# ---------- Postgres ----------
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=juan

# ---------- Redis ----------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=root
REDIS_DB=0

# ---------- 可选: T2I / Sandbox (留空表示未启用) ----------
# T2I_BASE_URL=http://localhost:8999
# SANDBOX_BASE_URL=http://localhost:8080
# SANDBOX_API_KEY=