{
  "annotations": [
    {
      "kind": "AnnotationQuery",
      "spec": {
        "builtIn": true,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "query": {
          "datasource": {
            "name": "-- Grafana --"
          },
          "group": "grafana",
          "kind": "DataQuery",
          "spec": {},
          "version": "v0"
        }
      }
    }
  ],
  "cursorSync": "Crosshair",
  "editable": true,
  "elements": {
    "panel-2": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "${DS_TRACING}"
                    },
                    "group": "tempo",
                    "kind": "DataQuery",
                    "spec": {
                      "limit": 50,
                      "query": "{ resource.service.name = \"$SERVICE\" }",
                      "queryType": "traceql"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": [
              {
                "group": "sortBy",
                "kind": "Transformation",
                "spec": {
                  "options": {
                    "sort": [
                      {
                        "desc": true,
                        "field": "Start time"
                      }
                    ]
                  }
                }
              },
              {
                "group": "organize",
                "kind": "Transformation",
                "spec": {
                  "options": {
                    "includeByName": {
                      "Name": true,
                      "Start Time": true,
                      "Start time": true,
                      "Trace ID": true,
                      "name": true,
                      "startTime": true,
                      "traceID": true,
                      "traceId": true
                    }
                  }
                }
              }
            ]
          }
        },
        "description": "",
        "id": 2,
        "links": [],
        "title": "Trace 列表（点击行 → 右侧详情）",
        "vizConfig": {
          "group": "table",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "custom": {
                  "align": "auto",
                  "cellOptions": {
                    "type": "auto"
                  },
                  "footer": {
                    "reducers": []
                  },
                  "inspect": false
                },
                "links": [
                  {
                    "targetBlank": false,
                    "title": "查看链路",
                    "url": "/d/juanniang-neo-traces?var-traceId=${__data.fields.traceID}"
                  }
                ],
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": 0
                    },
                    {
                      "color": "red",
                      "value": 80
                    }
                  ]
                }
              },
              "overrides": [
                {
                  "matcher": {
                    "id": "byRegexp",
                    "options": "(?i)trace.?id"
                  },
                  "properties": [
                    {
                      "id": "mappings",
                      "value": [
                        {
                          "options": {
                            "pattern": "^(.{5}).*",
                            "result": {
                              "index": 0,
                              "text": "$1…"
                            }
                          },
                          "type": "regex"
                        }
                      ]
                    }
                  ]
                },
                {
                  "matcher": {
                    "id": "byName",
                    "options": "Trace ID",
                    "scope": "series"
                  },
                  "properties": [
                    {
                      "id": "custom.width",
                      "value": 284
                    }
                  ]
                },
                {
                  "matcher": {
                    "id": "byName",
                    "options": "Name",
                    "scope": "series"
                  },
                  "properties": [
                    {
                      "id": "custom.width",
                      "value": 121
                    }
                  ]
                },
                {
                  "matcher": {
                    "id": "byName",
                    "options": "Start time",
                    "scope": "series"
                  },
                  "properties": [
                    {
                      "id": "custom.width",
                      "value": 156
                    }
                  ]
                }
              ]
            },
            "options": {
              "cellHeight": "sm",
              "showHeader": true,
              "sortBy": [
                {
                  "desc": true,
                  "displayName": "Start time"
                }
              ]
            }
          },
          "version": "13.1.3"
        }
      }
    },
    "panel-3": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "${DS_TRACING}"
                    },
                    "group": "tempo",
                    "kind": "DataQuery",
                    "spec": {
                      "query": "${traceId}",
                      "queryType": "traceql"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "",
        "id": 3,
        "links": [],
        "title": "链路详情（Traces 面板）",
        "vizConfig": {
          "group": "traces",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {},
              "overrides": []
            },
            "options": {
              "showTraceId": true,
              "spanBar": {
                "type": "Duration"
              },
              "spanFilters": {
                "criticalPathOnly": false,
                "matchesOnly": false
              }
            }
          },
          "version": "13.1.3"
        }
      }
    }
  },
